# Uso local sin Docker: copiar a api/.env (NO subir .env al repositorio).
# En Docker las variables las define deploy/docker-compose.yml desde deploy/.env.
DATABASE_URL=sqlite:///./local.db
# PostgreSQL (contenedor db, desde la red de compose):
# DATABASE_URL=postgresql+psycopg://sensores_app:CAMBIAR@db:5432/sensores

# Una o varias claves separadas por coma (generar con: python3 -c "import secrets;print(secrets.token_urlsafe(32))")
API_KEYS=cambiar-esta-clave

MAX_BODY_BYTES=16384
AUTO_CREATE_TABLES=true
