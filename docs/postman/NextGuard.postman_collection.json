        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensor\": \"{{sensor}}\",\n  \"cliente\": \"{{cliente}}\",\n  \"tipo\": \"temperatura\",\n  \"valor\": 250,\n  \"unidad\": \"C\"\n}",
          "options": {
