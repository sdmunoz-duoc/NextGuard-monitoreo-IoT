            "lecturas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensor\": \"{{sensor}}\",\n  \"cliente\": \"{{cliente}}\",\n  \"tipo\": \"temperatura\",\n  \"valor\": 20,\n  \"unidad\": \"C\",\n  \"timestamp\": \"2999-01-01T00:00:00Z\"\n}",
