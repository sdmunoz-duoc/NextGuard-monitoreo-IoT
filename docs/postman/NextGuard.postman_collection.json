          "path": [
            "api",
            "v1",
            "lecturas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensor\": \"{{sensor}}\",\n  \"cliente\": \"{{cliente}}\",\n  \"ubicacion\": \"Sede AV - Lab 3\",\n  \"tipo\": \"temperatura\",\n  \"valor\": 22.5,\n  \"unidad\": \"C\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('estado guardado', () => pm.expect(pm.response.json().estado).to.eql('guardado'));"
            ]
          }
        }
      ]
    },
