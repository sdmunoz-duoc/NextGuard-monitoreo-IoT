{
  "info": {
    "name": "NextGuard · API de sensores",
    "description": "Pruebas de la API (semana 12-13). Variables: baseUrl, apiKey, cliente. Ejecutar en orden con el Collection Runner; en el Runner use un retraso de ~1200 ms entre peticiones (InfluxDB 2.x tarda unas décimas de segundo en hacer visible una escritura). Por consola: npx newman run NextGuard.postman_collection.json --delay-request 1200",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiKey",
      "value": "clave-local"
    },
    {
      "key": "cliente",
      "value": "cliente-postman"
    },
    {
      "key": "sensor",
      "value": "sensor-postman"
    }
  ],
  "item": [
    {
      "name": "00 · Estado (/health)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('ambas bases ok', () => { const j = pm.response.json(); pm.expect(j.postgres).to.eql('ok'); pm.expect(j.influxdb).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "01 · Registrar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cliente\": \"{{cliente}}\",\n  \"nombre\": \"Cliente Postman\",\n  \"email\": \"postman@ejemplo.cl\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('sensor', 'postman-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 creado o 409 ya existía', () => pm.expect([201, 409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Sin API key => 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/lecturas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "lecturas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sensor\": \"{{sensor}}\",\n  \"cliente\": \"{{cliente}}\",\n  \"ubicacion\": \"Postman\",\n  \"seq\": 1,\n  \"mediciones\": [\n    {\n      \"tipo\": \"temperatura\",\n      \"valor\": 22.5,\n      \"unidad\": \"C\"\n    },\n    {\n      \"tipo\": \"humedad\",\n      \"valor\": 48,\n      \"unidad\": \"%\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · Lectura del formato de la clase => 201",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/lecturas",
          "host": [
            "{{baseUrl}}"
