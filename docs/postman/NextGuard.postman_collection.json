    {
      "name": "10 · Lote => 200",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/lecturas/batch",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "lecturas",
            "batch"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lecturas\": [\n    {\n      \"sensor\": \"{{sensor}}\",\n      \"cliente\": \"{{cliente}}\",\n      \"ubicacion\": \"Postman\",\n      \"seq\": 2,\n      \"mediciones\": [\n        {\n          \"tipo\": \"temperatura\",\n          \"valor\": 22.5,\n          \"unidad\": \"C\"\n        },\n        {\n          \"tipo\": \"humedad\",\n          \"valor\": 48,\n          \"unidad\": \"%\"\n        }\n      ]\n    },\n    {\n      \"sensor\": \"{{sensor}}\",\n      \"cliente\": \"{{cliente}}\",\n      \"ubicacion\": \"Postman\",\n      \"seq\": 3,\n      \"mediciones\": [\n        {\n          \"tipo\": \"temperatura\",\n          \"valor\": 22.5,\n          \"unidad\": \"C\"\n        },\n        {\n          \"tipo\": \"humedad\",\n          \"valor\": 48,\n          \"unidad\": \"%\"\n        }\n      ]\n    },\n    {\n      \"sensor\": \"{{sensor}}\",\n      \"cliente\": \"{{cliente}}\",\n      \"ubicacion\": \"Postman\",\n      \"seq\": 1,\n      \"mediciones\": [\n        {\n          \"tipo\": \"temperatura\",\n          \"valor\": 22.5,\n          \"unidad\": \"C\"\n        },\n        {\n          \"tipo\": \"humedad\",\n          \"valor\": 48,\n          \"unidad\": \"%\"\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('2 nuevas y 1 duplicada', () => { const j = pm.response.json(); pm.expect(j.insertadas).to.eql(2); pm.expect(j.duplicadas).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 · Sensores del cliente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/clientes/{{cliente}}/sensores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes",
            "{{cliente}}",
            "sensores"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('incluye el sensor', () => pm.expect(pm.response.json().map(s => s.sensor)).to.include(pm.collectionVariables.get('sensor')));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 · Lecturas del sensor (InfluxDB)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-Key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/clientes/{{cliente}}/sensores/{{sensor}}/lecturas?limite=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes",
            "{{cliente}}",
            "sensores",
            "{{sensor}}",
            "lecturas"
          ],
          "query": [
            {
              "key": "limite",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('hay lecturas', () => pm.expect(pm.response.json().length).to.be.above(0));"
            ]
          }
        }
      ]
    }
