      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('duplicado', () => pm.expect(pm.response.json().duplicado).to.eql(true));"
            ]
          }
        }
      ]
    },
