# Copiar a .env (NO subir .env al repositorio). Genera claves con: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=cambiar
INFLUX_RETENCION=0
POSTGRES_PASSWORD=cambiar
# Una o varias claves de la API separadas por coma
API_KEYS=cambiar-esta-clave
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar
# Alertas por correo (opcional). Gmail: clave de aplicación de 16 caracteres
GF_SMTP_ENABLED=false
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
ALERTA_DESTINATARIOS=correo1@ejemplo.cl;correo2@ejemplo.cl
